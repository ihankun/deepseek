{
  "name": "@deepseek-ai/dsh-electron-app",
  "description": "The dsh desktop app: an Electron shell running the dsh web server and GUI in a window",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/electron"
  },
  "type": "module",
  "main": "lib/main.js",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "lib/main.js",
    "lib/types/preload.mjs",
    "assets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "author": "DeepSeek",
  "scripts": {
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "gen:icons": "node --import tsx/esm scripts/gen-electron-icons.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "ai.deepseek.harness",
    "productName": "DeepSeek",
    "directories": {
      "output": "release"
    },
    "files": [
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
